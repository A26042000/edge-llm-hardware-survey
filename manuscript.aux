\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces One decoder block of a Llama-style LLM during batch-1 decode, tagged by operation type. The dense GEMV work (blue) is what quantization and compute-in-memory make cheap; the non-GEMM operations (orange) and the memory-only KV cache (green) are not served by that datapath. Dashed arrows show the key and value of the current token being appended to the cache after the RoPE rotation, and the full cache being re-read by the two attention products; dotted lines are the residual connections. This colour coding is used throughout the survey.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:decoder}{{4}{7}{One decoder block of a Llama-style LLM during batch-1 decode, tagged by operation type. The dense GEMV work (blue) is what quantization and compute-in-memory make cheap; the non-GEMM operations (orange) and the memory-only KV cache (green) are not served by that datapath. Dashed arrows show the key and value of the current token being appended to the cache after the RoPE rotation, and the full cache being re-read by the two attention products; dotted lines are the residual connections. This colour coding is used throughout the survey}{figure.4}{}}
\newlabel{fig:decoder@cref}{{[figure][4][]4}{[1][7][]7}}
